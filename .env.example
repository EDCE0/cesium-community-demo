# ============================================================================
# 环境配置（复制为 .env 后按需修改）
#   本项目所有外部依赖都是"可选"的：一个都不配也能跑通完整 Demo，
#   只是 Agent 会用离线规则引擎、检索会退化为 BM25。
# ============================================================================

# ---------- 服务端口 ----------
# 单端口对外：前端页面 + REST API + WebSocket(Agent/MCP) 全部走这个端口
PORT=8787

# 绑定地址：0.0.0.0 表示允许其他机器通过 IP 访问（远程演示必须）
HOST=0.0.0.0

# 独立的 MCP runtime WebSocket 端口（兼容 cesium-mcp-runtime 默认约定）
WS_PORT=9100

# ---------- 大模型（右下角对话框的大脑） ----------
# 可选：deepseek / openai / ollama / offline
LLM_PROVIDER=deepseek
# 填入你自己的 Key（真实 Key 请只放在 .env，它已被 .gitignore 忽略）
LLM_API_KEY=sk-your-api-key-here
# flash 模型：响应快、成本低，适合"知识库检索 + Agent 操控"这类高频交互
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=45000
# 模型名不可用时自动回退到的兜底模型
LLM_FALLBACK_MODEL=deepseek-chat

# ---------- RAG 检索 ----------
RAG_TOP_K=4
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_SCORE_THRESHOLD=0.05

# 向量检索（可选）：留空则使用 BM25 字级检索，零依赖即可工作
#   EMBEDDING_PROVIDER=ollama   → 本地 Ollama 生成向量
#   EMBEDDING_PROVIDER=openai   → 云端 embedding 接口
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=

# Qdrant 向量库（可选）：填上且服务可用时启用向量检索
QDRANT_URL=
QDRANT_COLLECTION=community_property_kb

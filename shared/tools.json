{
  "_comment": "Agent 可用命令的全集：19 个 cesium-mcp-bridge 内置命令 + 24 个市政领域命令 = 43 个。前端注册表、后端 function calling、MCP stdio 三种入口共用本清单。",
  "version": "1.0.0",
  "total": 43,
  "bridge": [
    { "name": "flyTo", "description": "飞到指定经纬度与高度（可带朝向与俯仰角）", "parameters": { "type": "object", "properties": { "longitude": { "type": "number", "description": "经度" }, "latitude": { "type": "number", "description": "纬度" }, "height": { "type": "number", "description": "相机高度（米）" }, "heading": { "type": "number" }, "pitch": { "type": "number" }, "roll": { "type": "number" }, "duration": { "type": "number" } }, "required": ["longitude", "latitude"] } },
    { "name": "setView", "description": "瞬间设置相机位置与姿态（不做飞行动画）", "parameters": { "type": "object", "properties": { "longitude": { "type": "number" }, "latitude": { "type": "number" }, "height": { "type": "number" }, "heading": { "type": "number" }, "pitch": { "type": "number" }, "roll": { "type": "number" } }, "required": ["longitude", "latitude"] } },
    { "name": "getView", "description": "读取当前相机状态（位置/朝向/俯仰）", "parameters": { "type": "object", "properties": {} } },
    { "name": "zoomToExtent", "description": "缩放到指定经纬度范围", "parameters": { "type": "object", "properties": { "bbox": { "type": "array", "items": { "type": "number" }, "description": "[west, south, east, north]" }, "duration": { "type": "number" } }, "required": ["bbox"] } },
    { "name": "addGeoJsonLayer", "description": "加载 GeoJSON 图层并按样式渲染", "parameters": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "data": { "type": "object", "description": "GeoJSON 对象" }, "style": { "type": "object", "description": "样式：color/opacity/pointSize/choropleth/category" }, "dataRefId": { "type": "string", "description": "复用已加载的数据集" } }, "required": ["data"] } },
    { "name": "addHeatmap", "description": "生成热力图图层", "parameters": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "data": { "type": "object" }, "radius": { "type": "number" }, "gradient": { "type": "object" } }, "required": ["data"] } },
    { "name": "addMarker", "description": "在指定经纬度添加点标记", "parameters": { "type": "object", "properties": { "longitude": { "type": "number" }, "latitude": { "type": "number" }, "label": { "type": "string" }, "color": { "type": "string" }, "size": { "type": "number" } }, "required": ["longitude", "latitude"] } },
    { "name": "addLabel", "description": "在图层要素上批量添加文字标注", "parameters": { "type": "object", "properties": { "dataRefId": { "type": "string" }, "data": { "type": "object" }, "field": { "type": "string" }, "style": { "type": "object" } }, "required": ["field"] } },
    { "name": "removeLayer", "description": "移除指定图层", "parameters": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },
    { "name": "setLayerVisibility", "description": "显示或隐藏图层（bridge 内置图层系统）", "parameters": { "type": "object", "properties": { "id": { "type": "string" }, "visible": { "type": "boolean" } }, "required": ["id", "visible"] } },
    { "name": "listLayers", "description": "列出当前已加载的图层", "parameters": { "type": "object", "properties": {} } },
    { "name": "updateLayerStyle", "description": "动态修改图层样式（颜色/透明度/线宽）", "parameters": { "type": "object", "properties": { "layerId": { "type": "string" }, "layerStyle": { "type": "object" }, "labelStyle": { "type": "object" } }, "required": ["layerId"] } },
    { "name": "setBasemap", "description": "切换底图（dark / satellite / standard / 自定义）", "parameters": { "type": "object", "properties": { "basemap": { "type": "string" } }, "required": ["basemap"] } },
    { "name": "highlight", "description": "高亮图层中的要素", "parameters": { "type": "object", "properties": { "layerId": { "type": "string" }, "featureIndex": { "type": "number" }, "color": { "type": "string" } }, "required": ["layerId"] } },
    { "name": "load3dTiles", "description": "加载 3D Tiles 数据集（BIM / 倾斜摄影）", "parameters": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string" }, "maximumScreenSpaceError": { "type": "number" }, "heightOffset": { "type": "number" } }, "required": ["url"] } },
    { "name": "loadTerrain", "description": "切换地形服务（flat / arcgis / cesiumion / 自定义 url）", "parameters": { "type": "object", "properties": { "provider": { "type": "string" }, "url": { "type": "string" }, "cesiumIonAssetId": { "type": "number" } }, "required": ["provider"] } },
    { "name": "loadImageryService", "description": "挂载 WMS / WMTS / XYZ / ArcGIS 影像服务（如天地图）", "parameters": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string" }, "serviceType": { "type": "string" }, "layerName": { "type": "string" }, "opacity": { "type": "number" } }, "required": ["url", "serviceType"] } },
    { "name": "playTrajectory", "description": "沿坐标路径播放实体动画（巡检车、抢修车）", "parameters": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }, "durationSeconds": { "type": "number" }, "trailSeconds": { "type": "number" }, "label": { "type": "string" } }, "required": ["coordinates"] } },
    { "name": "screenshot", "description": "截取当前三维视图，返回 base64 PNG", "parameters": { "type": "object", "properties": {} } }
  ],
  "domain": [
    { "name": "overviewSite", "description": "把相机拉到能看清整个小区全景的俯视视角", "parameters": { "type": "object", "properties": { "duration": { "type": "number", "description": "飞行秒数，默认 1.6" } } } },
    { "name": "listBuildings", "description": "列出小区所有楼栋的名称与编号，用于确定用户说的“3 号楼”是哪一栋", "parameters": { "type": "object", "properties": { "type": { "type": "string", "enum": ["residential", "community", "school", "commercial", "utility", "parking"] }, "sortBy": { "type": "string", "enum": ["id", "floors", "occupancyRate", "units"] } } } },
    { "name": "selectBuilding", "description": "选中并飞到指定楼栋，同时弹出信息卡片", "parameters": { "type": "object", "properties": { "buildingId": { "type": "string", "description": "楼栋编号（如 B07）或名称（如 7 号楼）" }, "fly": { "type": "boolean" } }, "required": ["buildingId"] } },
    { "name": "expandFloors", "description": "把指定楼栋按楼层“抽屉式”展开，逐层分离显示", "parameters": { "type": "object", "properties": { "buildingId": { "type": "string" } }, "required": ["buildingId"] } },
    { "name": "collapseFloors", "description": "收起当前已展开的楼层分层视图", "parameters": { "type": "object", "properties": {} } },
    { "name": "highlightFloor", "description": "在已展开的楼栋中高亮某一层", "parameters": { "type": "object", "properties": { "floor": { "type": "number" } }, "required": ["floor"] } },
    { "name": "showUnderground", "description": "切换到地下隧道视角查看埋地管线；false 返回地表", "parameters": { "type": "object", "properties": { "enabled": { "type": "boolean" } } } },
    { "name": "setPipeFilter", "description": "按管网类型过滤显示的管线", "parameters": { "type": "object", "properties": { "types": { "type": "array", "items": { "type": "string", "enum": ["water", "gas", "sewage", "all"] } } }, "required": ["types"] } },
    { "name": "setPipeDepthScale", "description": "放大管线埋深以便观察（1 = 真实埋深）", "parameters": { "type": "object", "properties": { "scale": { "type": "number" } }, "required": ["scale"] } },
    { "name": "listPipes", "description": "列出地下管线的编号、类型、管径、材质、埋深与管龄", "parameters": { "type": "object", "properties": { "type": { "type": "string", "enum": ["water", "gas", "sewage"] }, "minAge": { "type": "number" } } } },
    { "name": "queryPipeHealth", "description": "查询管线健康度，识别需要优先更换的管段", "parameters": { "type": "object", "properties": { "level": { "type": "string", "enum": ["high", "medium", "low"] }, "topN": { "type": "number" } } } },
    { "name": "listSensors", "description": "列出 IoT 点位清单", "parameters": { "type": "object", "properties": { "type": { "type": "string", "enum": ["pressure", "gas", "level", "flow", "power"] } } } },
    { "name": "queryIotRealtime", "description": "查询 IoT 点位实时读数与告警状态", "parameters": { "type": "object", "properties": { "sensorId": { "type": "string" }, "buildingId": { "type": "string" } } } },
    { "name": "setSimulate", "description": "控制 IoT 数据模拟或注入人为故障（演示告警联动）", "parameters": { "type": "object", "properties": { "action": { "type": "string", "enum": ["start", "stop", "injectFault"] }, "fault": { "type": "string", "enum": ["gasLeak", "waterDrop", "powerOverload"] } } } },
    { "name": "listAlarms", "description": "查询设备告警事件列表", "parameters": { "type": "object", "properties": { "level": { "type": "string", "enum": ["critical", "warning", "info"] }, "days": { "type": "number" }, "limit": { "type": "number" } } } },
    { "name": "queryStats", "description": "查询统计数据：用水/用气/用电趋势、入住率、管线健康度、告警频次", "parameters": { "type": "object", "properties": { "metric": { "type": "string", "enum": ["water", "gas", "power", "occupancy", "pipeHealth", "alarms"] }, "scope": { "type": "string", "description": "community 或楼栋编号" }, "days": { "type": "number" } }, "required": ["metric"] } },
    { "name": "showChart", "description": "在三维场景上叠加统计图表", "parameters": { "type": "object", "properties": { "type": { "type": "string", "enum": ["line", "bar", "pie", "gauge"] }, "title": { "type": "string" }, "metric": { "type": "string", "enum": ["water", "gas", "power", "occupancy", "pipeHealth", "alarms"] }, "scope": { "type": "string" } }, "required": ["metric"] } },
    { "name": "showInfoCard", "description": "弹出信息卡片（楼栋 / 管段 / 测点 / 自定义文本）", "parameters": { "type": "object", "properties": { "kind": { "type": "string", "enum": ["building", "pipe", "sensor", "text"] }, "id": { "type": "string" }, "title": { "type": "string" }, "content": { "type": "string" } }, "required": ["kind"] } },
    { "name": "showTooltip", "description": "在三维场景中显示一条悬浮提示", "parameters": { "type": "object", "properties": { "text": { "type": "string" }, "longitude": { "type": "number" }, "latitude": { "type": "number" }, "height": { "type": "number" }, "duration": { "type": "number" } }, "required": ["text"] } },
    { "name": "setPanel", "description": "打开或关闭界面面板", "parameters": { "type": "object", "properties": { "panel": { "type": "string", "enum": ["layers", "stats", "chat", "card", "alarms", "legend"] }, "open": { "type": "boolean" } }, "required": ["panel"] } },
    { "name": "toggleLayer", "description": "显示或隐藏三维图层", "parameters": { "type": "object", "properties": { "layer": { "type": "string", "enum": ["buildings", "roads", "greens", "pipes", "sensors", "baseMap"] }, "visible": { "type": "boolean" } }, "required": ["layer"] } },
    { "name": "setFloorMode", "description": "切换楼层显示模式：normal 白模 / exploded 分层展开", "parameters": { "type": "object", "properties": { "mode": { "type": "string", "enum": ["normal", "exploded"] }, "buildingId": { "type": "string" } }, "required": ["mode"] } },
    { "name": "showTrajectoryDemo", "description": "播放一次巡检车辆沿小区道路的巡游动画", "parameters": { "type": "object", "properties": { "route": { "type": "string", "enum": ["ring", "main", "gas"] }, "speed": { "type": "number" } } } },
    { "name": "resetView", "description": "恢复默认视角与图层状态", "parameters": { "type": "object", "properties": {} } }
  ]
}
